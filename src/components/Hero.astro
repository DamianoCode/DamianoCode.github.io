---
import SiteHeader from './SiteHeader.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';

// Dowód już na pierwszym ekranie: główny projekt i adres, pod którym działa.
const lead = projects.find((project) => project.tier === 'lead')!;
const live = lead.links[0];

// Szerokość każdej linii w em w spoczynku (szerokość 58, grubość 850), zmierzona w przeglądarce: przybliżone
// dopasowanie, zanim skrypt soczewki dopasuje napis dokładnie.
const lines = [
  { word: profile.name, em: 2.45 },
  { word: profile.surname, em: 1.51 },
];
---

<header class="hero" aria-labelledby="hero-title">
  <!-- Pierwszy arkusz strony: papierowy, w ramie z sadzy, z nagłówkiem strony w środku. Na komputerze przy przewijaniu zostaje
       przypięty i odsuwa się w głąb, a następna sekcja nasuwa się na niego jak kolejny arkusz na stos.
       Strona zamyka się karminowym arkuszem Kontakt. Cały arkusz jest nagłówkiem strony (banner), więc stoi
       przed <main>, a skok do treści prowadzi od razu do projektów. -->
  <div class="hero-pin">
  <div class="sheet hero-sheet">
    <SiteHeader />
    <div class="wrap hero-inner">
      <div class="stage">
        <h1 id="hero-title" class="hero-title">
          <span class="visually-hidden">{profile.fullName}, {profile.role.toLowerCase()}</span>
          <span class="type" aria-hidden="true" data-type>
            {lines.map(({ word, em }) => (
              <span class="line" style={`--em-width: ${em}`} data-line>
                <span class="word">
                  {[...word].map((ch) => (
                    <span class="ch">{ch}</span>
                  ))}
                </span>
              </span>
            ))}
          </span>
        </h1>

        <p class="role">
          Buduję aplikacje.<br />Ogarniam agentów.
        </p>
      </div>

      <div class="intro">
        <p>
          Aplikacje od bazy danych po interfejs: Next.js, TypeScript, PostgreSQL. Ostatnio {lead.name},
          wspólna mapa dla paczki znajomych. Działa na <a href={live.href}>{live.label}</a>.
        </p>
        <p class="intro-actions">
          <a class="cta" href="#projekty">
            Zobacz projekty
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
          <a href="#kontakt">Napisz do mnie</a>
        </p>
      </div>

      <dl class="rail">
        <div>
          <dt class="visually-hidden">Miasto</dt>
          <dd>
            <svg class="pin" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" />
              <circle cx="12" cy="9.8" r="2.3" />
            </svg>
            {profile.city} · {profile.remote}
          </dd>
        </div>
        <div>
          <dt class="visually-hidden">Dostępność</dt>
          <dd><span class="status-dot" aria-hidden="true"></span>Otwarty na {profile.availability}</dd>
        </div>
      </dl>
    </div>
  </div>
  </div>
</header>

<script>
  import { initTypeLens } from '../scripts/type-lens';

  const root = document.querySelector<HTMLElement>('[data-type]');
  const section = root?.closest<HTMLElement>('.hero');
  if (root && section) initTypeLens(root, section);

  // Przypięty arkusz po przewinięciu jest pod następną sekcją. Fokus klawiatury w nim przewija stronę na górę,
  // gdzie hero jest w pełni widoczne.
  const pin = document.querySelector<HTMLElement>('.hero-pin');
  section?.addEventListener('focusin', (e) => {
    const target = e.target as HTMLElement;
    if (pin && scrollY > 0 && target.matches(':focus-visible') && getComputedStyle(pin).position === 'sticky') {
      scrollTo({ top: 0 });
    }
  });
</script>

<style>
  .hero {
    /* Kolory arkusza są stałe w obu motywach: papier, sadza i karmin jak w znaku. */
    --sheet-bg: var(--brand-paper);
    --select-bg: var(--brand-crimson);
    --select-ink: var(--brand-paper);
    --ink: var(--brand-ink);
    --ink-soft: #5a564f;
    --accent: var(--brand-crimson);
    --mark-body: var(--brand-ink);
    --row-gap: clamp(0.25rem, 1.5vh, 1rem);
    position: relative;
    color: var(--ink);
  }
  /* Rama z sadzy wokół papierowego arkusza, w obu motywach. */
  .hero-pin {
    padding-block: var(--sheet-gap);
    background: var(--brand-ink);
  }

  /* Arkusz ma zaokrąglenia pozostałych (klasa `.sheet`), ale nie ich największą szerokość: zajmuje całe okno
     z małym odstępem od krawędzi i mieści się w pierwszym ekranie. Nagłówek u góry, treść przy dolnej krawędzi. */
  .hero-sheet {
    margin-inline: var(--sheet-gap);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 2 * var(--sheet-gap));
    padding-bottom: clamp(2rem, 6vh, 4rem);
    background: var(--sheet-bg);
  }
  /* Nagłówek i treść hero rozciągają się na całą szerokość arkusza, a nie na kolumnę 88rem pozostałych sekcji:
     na dużym monitorze napis wypełnia okno zamiast stać w wąskim pasie pośrodku. */
  .hero-sheet :global(.site-head) {
    max-width: none;
  }
  /* Najmniejszy odstęp od menu: na niskim laptopie treść wypełnia cały arkusz i imię stykało się z menu. */
  .hero-inner {
    max-width: none;
    margin-top: auto;
    padding-top: clamp(0.75rem, 2.5vh, 1.5rem);
  }
  .hero :focus-visible {
    outline-color: var(--accent);
  }

  /* Pierwsza sekcja treści jest nieprzezroczysta i leży nad hero: przy przewijaniu nasuwa się na arkusz. */
  :global(.hero ~ main > section:first-of-type) {
    position: relative;
    z-index: 1;
    background: var(--paper);
  }

  /* Rama napisu: imię i nazwisko jedno pod drugim, wyrównane do lewej, pod nimi hasło. */
  .stage {
    position: relative;
    --type-height: clamp(9rem, min(calc(100svh - 36rem), 64vw), 52rem);
  }

  .type {
    display: grid;
    grid-template-rows: 1fr 1fr;
    row-gap: var(--row-gap);
    height: var(--type-height);
    overflow-x: clip;
    /* Zmiany kształtu liter nie wpływają na układ reszty strony. */
    contain: layout;
  }
  .line {
    display: flex;
    align-items: flex-end;
    min-width: 0;
    min-height: 0;
    container-type: size;
  }
  /* Skrypt skaluje napis od lewej krawędzi. */
  .word {
    transform-origin: left bottom;
  }
  .word {
    display: block;
    white-space: nowrap;
    font-family: var(--display);
    /* Przybliżone dopasowanie przed startem skryptu; skrypt dopasowuje dokładnie. */
    font-size: min(100cqw / var(--em-width), 100cqh / 0.8);
    font-weight: var(--heavy);
    line-height: 0.8;
    letter-spacing: -0.005em;
  }
  .ch {
    display: inline-block;
    font-variation-settings: 'wdth' 58, 'wght' 850;
  }

  /* Po starcie skryptu każda litera stoi na własnej pozycji i przesuwa ją transform.
     Dzięki temu zmiana szerokości niczego nie przesuwa w układzie strony (zero CLS). */
  .type.is-live .line {
    position: relative;
  }
  .type.is-live .word,
  .type.is-live .ch {
    position: absolute;
    left: 0;
    bottom: 0;
  }
  .type.is-live .word {
    transform-origin: left bottom;
  }

  /* Hasło: ten sam ciężki, wąski głos co imię, w karminie. */
  .role {
    margin-top: clamp(1rem, 2.5vh, 1.75rem);
    font-family: var(--display);
    font-weight: var(--heavy);
    font-stretch: var(--tight);
    /* Hasło rośnie z szerokością, ale na niskim ekranie także maleje z wysokością: imię ma zostać co najmniej
       2.5 raza większe, inaczej na laptopie 1280×720 wychodzą trzy równe nagłówki. */
    font-size: clamp(1.75rem, min(3.6vw, 6svh), 3.4rem);
    line-height: 0.98;
    letter-spacing: -0.005em;
    color: var(--accent);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.25rem, 3vh, 2.25rem);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--label-l);
  }
  .intro-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .cta {
    gap: 0.75rem;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius-control);
    background: var(--accent);
    color: var(--brand-paper) !important;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  .cta svg {
    width: 1.2em;
    height: 1.2em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cta:hover {
    background: var(--brand-crimson-deep);
  }
  .cta:active {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta svg {
      transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .cta:hover svg {
      transform: translateX(0.2em);
    }
  }

  /* Stopka arkusza: cienka kreska, miasto po lewej, dostępność po prawej. */
  .rail {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin: clamp(1.5rem, 4vh, 2.75rem) 0 0;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 40%, transparent);
    font-family: var(--display);
    font-size: var(--label);
    font-weight: 600;
    font-stretch: 90%;
    line-height: 1.3;
  }
  .rail dd {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .pin {
    width: 1.15em;
    height: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .status-dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #1e6b47;
    box-shadow: 0 0 0 0 color-mix(in srgb, #1e6b47 50%, transparent);
  }

  /* Telefon: wąski krój czyta się dobrze w dużym rozmiarze, ale przy 28 px prześwity w a, e, s się zamykają.
     Hasło zostaje w tym samym głosie, tylko szersze i odrobinę większe. */
  @media (max-width: 40rem) {
    .role {
      font-size: var(--step-2);
      font-stretch: 68%;
    }
  }

  /* Niski laptop (1280×720, 1366×768): stałe odstępy zjadały wysokość imienia, aż hasło dorównywało mu
     rozmiarem. Ciaśniejsze odstępy oddają imieniu ok. 5rem, więc zostaje ok. 2.5 raza większe od hasła. */
  @media (min-width: 48rem) and (max-height: 50rem) {
    .hero-sheet {
      padding-bottom: 1.25rem;
    }
    .stage {
      --type-height: clamp(9rem, calc(100svh - 31rem), 52rem);
    }
    .role {
      margin-top: 0.6rem;
    }
    .intro {
      gap: 0.75rem;
      margin-top: 0.9rem;
    }
    .rail {
      margin-top: 1rem;
      padding-top: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-dot {
      animation: pulse 2.4s ease-out infinite;
    }

    /* Telefon i niskie okno: hero przewija się normalnie, a wychodząc z ekranu lekko maleje. */
    @supports (animation-timeline: view()) {
      .hero {
        view-timeline: --hero;
      }
      .hero-sheet {
        transform-origin: 50% 100%;
        animation: leave linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }
    }
  }

  /* Komputer: stos arkuszy. Sekcja hero jest torem o wysokość ekranu dłuższym od arkusza; arkusz jest w nim
     przypięty, maleje i ciemnieje, a następna sekcja (podciągnięta o tę samą wysokość) nasuwa się na niego
     z zaokrąglonymi rogami i cieniem. Arkusz nie wychodzi poza swój tor, więc nigdy nie prześwituje pod
     dalszymi sekcjami. Animowane są tylko transform i opacity. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 64rem) and (min-height: 44rem) {
    @supports (animation-timeline: scroll()) {
      .hero {
        --travel: 100svh;
        height: calc(100svh + var(--travel));
      }
      .hero-pin {
        position: sticky;
        top: 0;
        height: 100svh;
      }
      /* Tło pod arkuszem gaśnie razem z nim, więc krawędź i rogi wjeżdżającej sekcji są wyraźne w obu motywach. */
      .hero-pin::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: #0b0b0d;
        opacity: 0;
        pointer-events: none;
        animation: fade-in linear both;
        animation-timeline: scroll(root);
        animation-range: 0 var(--travel);
      }
      .hero-sheet {
        transform-origin: 50% 50%;
        animation: recede linear both;
        animation-timeline: scroll(root);
        animation-range: 0 var(--travel);
      }
      .hero-sheet::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--brand-ink);
        pointer-events: none;
        opacity: 0;
        animation: dim linear both;
        animation-timeline: scroll(root);
        animation-range: 0 var(--travel);
      }
      /* <main> zaczyna się pod torem hero, ale pierwsza sekcja wystaje z niego w górę o długość toru;
         skok do treści ma się zatrzymać na niej, a nie ekran niżej. */
      :global(.hero ~ main) {
        scroll-margin-top: 100svh;
      }
      :global(.hero ~ main > section:first-of-type) {
        margin-top: calc(-1 * var(--travel, 100svh));
        border-radius: 2rem 2rem 0 0;
        box-shadow: 0 -1.25rem 3rem -1.5rem rgb(0 0 0 / 0.45);
        /* Rozmycie cienia sięga kilka pikseli poniżej sekcji i rysowało blady pas pod archiwum;
           cień ma padać tylko w górę, na hero. */
        clip-path: inset(-6rem -6rem 0 -6rem);
      }
    }
  }
  @keyframes leave {
    to {
      transform: scale(0.94);
    }
  }
  @keyframes recede {
    to {
      transform: scale(0.92);
    }
  }
  @keyframes dim {
    to {
      opacity: 0.22;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }
  @keyframes pulse {
    70%,
    100% {
      box-shadow: 0 0 0 0.45rem color-mix(in srgb, #1e6b47 0%, transparent);
    }
  }
</style>
