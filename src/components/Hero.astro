---
import { profile } from '../data/profile';

const lines = [profile.name, profile.surname];
---

<section class="wrap hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-title">
    <span class="visually-hidden">{profile.fullName}, {profile.role.toLowerCase()}</span>
    <span class="type" aria-hidden="true" data-type>
      {lines.map((word, i) => (
        <span class={`line ${i === 0 ? 'line-start' : 'line-end'}`} data-line>
          <span class="word">
            {[...word].map((ch) => (
              <span class="ch">{ch}</span>
            ))}
          </span>
        </span>
      ))}
    </span>
  </h1>

  <div class="intro">
    <p class="role">
      Fullstack developer.<br />Piszę kod razem z agentami AI.
    </p>
    <div class="intro-text">
      <p>
        Buduję aplikacje od bazy danych po interfejs: Next.js, TypeScript, PostgreSQL. Z Claude Code pracuję
        jak z drugim programistą, a do tego piszę narzędzia, które tę pracę porządkują.
      </p>
      <p class="intro-meta">{profile.city}. Jestem otwarty na nowe projekty.</p>
      <p class="intro-actions">
        <a href="#projekty">Zobacz projekty</a>
        <a href={`mailto:${profile.email}`}>Napisz do mnie</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { initTypeLens } from '../scripts/type-lens';

  const root = document.querySelector<HTMLElement>('[data-type]');
  const section = root?.closest('section');
  if (root && section) initTypeLens(root, section);
</script>

<style>
  .hero {
    padding-block: clamp(0.5rem, 3vh, 2rem) clamp(3rem, 8vh, 6rem);
  }

  .type {
    display: grid;
    grid-template-rows: 1fr 1fr;
    row-gap: clamp(0.25rem, 1.5vh, 1rem);
    height: clamp(11rem, min(calc(100svh - 20rem), 58vw), 48rem);
    overflow-x: clip;
    /* Zmiany kształtu liter nie wpływają na układ reszty strony. */
    contain: layout;
  }
  .line {
    display: flex;
    align-items: flex-end;
    min-width: 0;
    min-height: 0;
    container-type: size;
  }
  .line-start {
    --em-width: 3.75;
  }
  .line-end {
    --em-width: 2.25;
    justify-content: flex-end;
  }
  /* Skrypt skaluje napis od strony, do której linia jest wyrównana. */
  .line-start .word {
    transform-origin: left bottom;
  }
  .line-end .word {
    transform-origin: right bottom;
  }
  .word {
    display: block;
    white-space: nowrap;
    font-family: var(--display);
    /* Przybliżone dopasowanie przed startem skryptu; skrypt dopasowuje dokładnie. */
    font-size: min(100cqw / var(--em-width), 100cqh / 0.8);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.005em;
  }
  .ch {
    display: inline-block;
    font-variation-settings: 'wdth' 100, 'wght' 640;
  }

  /* Po starcie skryptu każda litera stoi na własnej pozycji i przesuwa ją transform.
     Dzięki temu zmiana szerokości niczego nie przesuwa w układzie strony (zero CLS). */
  .type.is-live .line {
    position: relative;
  }
  .type.is-live .word,
  .type.is-live .ch {
    position: absolute;
    left: 0;
    bottom: 0;
  }
  .type.is-live .word {
    transform-origin: left bottom;
  }

  .intro {
    display: grid;
    gap: 1.5rem 4rem;
    margin-top: clamp(1.25rem, 3vh, 2.5rem);
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
  }
  .role {
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    line-height: 1.08;
  }
  .intro-text {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .intro-meta {
    color: var(--ink-soft);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .intro-actions a:first-child {
    color: var(--paper);
    background: var(--ink);
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .intro-actions a:first-child:hover {
    background: var(--cobalt);
  }
  .intro-actions a:last-child {
    padding-block: 0.6rem;
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
