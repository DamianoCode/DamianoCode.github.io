---
import { profile } from '../data/profile';

const lines = [profile.name, profile.surname];
---

<section class="wrap hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-title">
    <span class="visually-hidden">{profile.fullName}, {profile.role.toLowerCase()}</span>
    <span class="type" aria-hidden="true" data-type>
      {lines.map((word, i) => (
        <span class={`line ${i === 0 ? 'line-start' : 'line-end'}`} data-line>
          <span class="word">
            {[...word].map((ch) => (
              <span class="ch">{ch}</span>
            ))}
          </span>
        </span>
      ))}
    </span>
  </h1>

  <div class="intro">
    <p class="role">
      Fullstack developer.<br />Na co dzień z agentami AI.
    </p>
    <div class="intro-text">
      <p>
        Buduję aplikacje od bazy danych po interfejs: Next.js, TypeScript, PostgreSQL. Z agentami AI i modelami
        językowymi pracuję codziennie, głównie w Claude Code, i piszę dla nich własne narzędzia.
      </p>
      <p class="intro-meta">{profile.city}. Jestem otwarty na nowe projekty.</p>
      <p class="intro-actions">
        <a href="#projekty">Zobacz projekty</a>
        <a href={`mailto:${profile.email}`}>Napisz do mnie</a>
      </p>
    </div>
  </div>
</section>

<script>
  type Char = { el: HTMLElement; w: number; g: number };
  type Line = { box: HTMLElement; word: HTMLElement; chars: Char[] };

  const root = document.querySelector<HTMLElement>('[data-type]');
  const section = root?.closest('section');

  if (root && section) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');

    // Oś szerokości i grubości kroju Anybody.
    const W = { min: 50, max: 150, rest: 100 };
    const G = { min: 280, max: 860, rest: 640 };
    const SPREAD = 0.17;
    const SWEEP_MS = 1500;

    const lines: Line[] = [...root.querySelectorAll<HTMLElement>('[data-line]')].map((box) => ({
      box,
      word: box.firstElementChild as HTMLElement,
      chars: [...box.querySelectorAll<HTMLElement>('.ch')].map((el) => ({ el, w: W.rest, g: G.rest })),
    }));

    // Pozycja soczewki: x w pikselach okna, y jako 0–1 wysokości napisu. null = spoczynek.
    let lensX: number | null = null;
    let lensY = 0.5;
    let sweepStart = 0;
    let frame = 0;

    const fit = (line: Line) => {
      line.word.style.fontSize = '100px';
      const width = line.word.getBoundingClientRect().width;
      const byWidth = (line.box.clientWidth / width) * 100;
      const byHeight = line.box.clientHeight / 0.8;
      line.word.style.fontSize = `${Math.min(byWidth, byHeight)}px`;
    };

    const paint = (c: Char) => {
      c.el.style.fontVariationSettings = `'wdth' ${c.w.toFixed(1)}, 'wght' ${c.g.toFixed(0)}`;
    };

    const tick = (now: number) => {
      if (sweepStart) {
        const t = (now - sweepStart) / SWEEP_MS;
        if (t >= 1) {
          sweepStart = 0;
          lensX = null;
        } else {
          const rect = root.getBoundingClientRect();
          const eased = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;
          lensX = rect.left + rect.width * (-0.15 + 1.3 * eased);
          lensY = 0.5;
        }
      }

      let moving = sweepStart !== 0;
      const rootRect = root.getBoundingClientRect();

      lines.forEach((line, li) => {
        const rect = line.word.getBoundingClientRect();
        const n = line.chars.length;
        const lineY = (li + 0.5) / lines.length;
        const amp = 0.35 + 0.65 * Math.max(0, 1 - Math.abs(lensY - lineY) * 1.3);

        line.chars.forEach((c, k) => {
          let tw = W.rest;
          let tg = G.rest;
          if (lensX !== null) {
            const pos = (k + 0.5) / n;
            const x = (lensX - rect.left) / Math.max(rect.width, 1);
            // Blisko kursora: szeroko i grubo. Daleko: wąsko i lekko.
            const influence = Math.exp(-((pos - x) ** 2) / (2 * SPREAD ** 2)) * amp;
            tw = W.min + (W.max - W.min) * influence;
            tg = G.min + (G.max - G.min) * influence;
          }
          c.w += (tw - c.w) * 0.16;
          c.g += (tg - c.g) * 0.16;
          if (Math.abs(tw - c.w) > 0.3 || Math.abs(tg - c.g) > 1) moving = true;
          paint(c);
        });
        fit(line);
      });

      frame = moving && rootRect.bottom > 0 ? requestAnimationFrame(tick) : 0;
    };

    const wake = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    const aimAt = (clientX: number, clientY: number) => {
      const rect = root.getBoundingClientRect();
      sweepStart = 0;
      lensX = clientX;
      lensY = Math.min(1, Math.max(0, (clientY - rect.top) / rect.height));
      wake();
    };

    const release = () => {
      lensX = null;
      wake();
    };

    const onPointerMove = (e: PointerEvent) => {
      if (e.pointerType === 'mouse' || e.pointerType === 'pen') aimAt(e.clientX, e.clientY);
    };

    // Na ekranach dotykowych soczewkę przesuwa przewijanie przez hero.
    const onScroll = () => {
      const rect = section.getBoundingClientRect();
      const progress = -rect.top / Math.max(rect.height * 0.6, 1);
      if (progress <= 0.02 || progress >= 1) return release();
      const typeRect = root.getBoundingClientRect();
      sweepStart = 0;
      lensX = typeRect.left + typeRect.width * (-0.1 + 1.2 * progress);
      lensY = progress;
      wake();
    };

    const bind = () => {
      section.removeEventListener('pointermove', onPointerMove);
      section.removeEventListener('pointerleave', release);
      removeEventListener('scroll', onScroll);
      if (reduce.matches) {
        lensX = null;
        sweepStart = 0;
        lines.forEach((line) => {
          line.chars.forEach((c) => {
            c.w = W.rest;
            c.g = G.rest;
            paint(c);
          });
          fit(line);
        });
        return;
      }
      if (finePointer.matches) {
        section.addEventListener('pointermove', onPointerMove, { passive: true });
        section.addEventListener('pointerleave', release, { passive: true });
      } else {
        addEventListener('scroll', onScroll, { passive: true });
      }
    };

    document.fonts.ready.then(() => {
      lines.forEach(fit);
      bind();
      if (!reduce.matches) {
        // Jedno wejście: soczewka przejeżdża przez napis, potem wszystko wraca do spoczynku.
        sweepStart = performance.now();
        wake();
      }
    });

    reduce.addEventListener('change', bind);
    finePointer.addEventListener('change', bind);
    new ResizeObserver(() => lines.forEach(fit)).observe(root);
  }
</script>

<style>
  .hero {
    padding-block: clamp(0.5rem, 3vh, 2rem) clamp(3rem, 8vh, 6rem);
  }

  .type {
    display: grid;
    grid-template-rows: 1fr 1fr;
    row-gap: clamp(0.25rem, 1.5vh, 1rem);
    height: clamp(11rem, min(calc(100svh - 20rem), 58vw), 48rem);
    overflow-x: clip;
  }
  .line {
    display: flex;
    align-items: flex-end;
    min-width: 0;
    min-height: 0;
    container-type: size;
  }
  .line-start {
    --em-width: 3.75;
  }
  .line-end {
    --em-width: 2.25;
    justify-content: flex-end;
  }
  .word {
    display: block;
    white-space: nowrap;
    font-family: var(--display);
    /* Przybliżone dopasowanie przed startem skryptu; skrypt dopasowuje dokładnie. */
    font-size: min(100cqw / var(--em-width), 100cqh / 0.8);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.005em;
  }
  .ch {
    display: inline-block;
    font-variation-settings: 'wdth' 100, 'wght' 640;
  }

  .intro {
    display: grid;
    gap: 1.5rem 4rem;
    margin-top: clamp(1.25rem, 3vh, 2.5rem);
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
  }
  .role {
    font-family: var(--display);
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    line-height: 1.08;
  }
  .intro-text {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .intro-meta {
    color: var(--ink-soft);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .intro-actions a:first-child {
    color: var(--paper);
    background: var(--ink);
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .intro-actions a:first-child:hover {
    background: var(--cobalt);
  }
  .intro-actions a:last-child {
    padding-block: 0.6rem;
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
