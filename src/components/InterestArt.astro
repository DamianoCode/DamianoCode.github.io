---
import type { InterestId } from '../data/profile';

/**
 * Rysunek w rogu kafla „Po godzinach”: fragment przedmiotu wychodzący poza krawędź, cienką kreską.
 * Elementy z `pathLength="1"` rysują się przy wjeździe kafla na ekran (style w Interests.astro).
 */
interface Props {
  id: InterestId;
}

const { id } = Astro.props;

const polar = (cx: number, cy: number, r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)].map((v) => +v.toFixed(2));
};

// Rower: szprychy obu kół, od piasty do obręczy.
const spokes = (cx: number, cy: number) =>
  Array.from({ length: 12 }, (_, i) => {
    const [x1, y1] = polar(cx, cy, 4, i * 30);
    const [x2, y2] = polar(cx, cy, 47, i * 30);
    return `M${x1} ${y1}L${x2} ${y2}`;
  }).join('');
const wheels = [
  [68, 140],
  [252, 140],
] as const;

// Giełda: świece od lewego dolnego rogu w górę. Rysunek, nie dane: kurs jest wymyślony.
const candles = [
  [70, 96, 62, 104],
  [62, 84, 56, 90],
  [84, 74, 70, 92],
  [74, 60, 52, 80],
  [60, 66, 56, 74],
  [66, 48, 40, 70],
  [48, 54, 44, 60],
  [54, 34, 26, 58],
  [34, 22, 14, 40],
].map(([open, close, high, low], i) => ({ x: 14 + i * 20, open, close, high, low, up: close < open }));
const average = candles.map((c, i) => `${c.x},${((c.open + c.close) / 2 + 6 - i * 0.6).toFixed(1)}`).join(' ');

// Komiks: wybuch onomatopei, gwiazda o naprzemiennie długich i krótkich ramionach.
const burst = Array.from({ length: 24 }, (_, i) => polar(50, 140, i % 2 ? 19 : 36, i * 15 - 90).join(' ')).join(' ');
---

{id === 'rower' && (
  <svg class="art art-rower" viewBox="0 0 320 200" aria-hidden="true">
    {wheels.map(([cx, cy]) => (
      <g class="wheel">
        <circle data-draw pathLength="1" cx={cx} cy={cy} r="54" />
        <circle cx={cx} cy={cy} r="47" />
        <path d={spokes(cx, cy)} />
        <circle cx={cx} cy={cy} r="4" />
      </g>
    ))}
    <path
      data-draw
      pathLength="1"
      d="M68 140L146 142L128 66ZM146 142L232 84L226 62L128 66M232 84Q238 108 252 140"
    />
    <path d="M128 66L124 50M110 48Q124 44 140 48M226 62L230 50M222 48H244Q256 48 256 60V64" />
    <circle cx="146" cy="142" r="13" />
    <path d="M146 142L158 160M152 160H164" />
  </svg>
)}

{id === 'gry' && (
  <svg class="art art-gry" viewBox="0 0 260 170" aria-hidden="true">
    <path
      data-draw
      pathLength="1"
      d="M70 30H190C222 30 240 46 246 76L256 128C260 150 248 166 230 166C216 166 206 156 198 140L188 120H72L62 140C54 156 44 166 30 166C12 166 0 150 4 128L14 76C20 46 38 30 70 30Z"
    />
    <path class="press" d="M64 62h12v12h12v12h-12v12h-12v-12h-12v-12h12z" />
    <circle class="press" style="--i: 1" cx="190" cy="64" r="7" />
    <circle class="press" style="--i: 2" cx="206" cy="80" r="7" />
    <circle class="press" style="--i: 3" cx="190" cy="96" r="7" />
    <circle class="press" style="--i: 4" cx="174" cy="80" r="7" />
    <rect x="110" y="60" width="14" height="6" rx="3" />
    <rect x="136" y="60" width="14" height="6" rx="3" />
    <circle cx="100" cy="104" r="12" />
    <circle cx="100" cy="104" r="5" />
    <circle cx="160" cy="104" r="12" />
    <circle cx="160" cy="104" r="5" />
  </svg>
)}

{id === 'gielda' && (
  <svg class="art art-gielda" viewBox="0 0 200 120" aria-hidden="true">
    {candles.map((c) => (
      <g class={c.up ? 'up' : 'down'}>
        <path d={`M${c.x} ${c.high}V${c.low}`} />
        <rect x={c.x - 5} y={Math.min(c.open, c.close)} width="10" height={Math.abs(c.open - c.close)} />
      </g>
    ))}
    <polyline data-draw pathLength="1" class="trend" points={average} />
  </svg>
)}

{id === 'anime' && (
  <svg class="art art-anime" viewBox="0 0 240 200" aria-hidden="true">
    <defs>
      <pattern id="screentone" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <circle cx="3.5" cy="3.5" r="1.3" />
      </pattern>
    </defs>
    <rect data-draw pathLength="1" x="0" y="0" width="150" height="70" />
    <rect data-draw pathLength="1" x="158" y="0" width="82" height="70" />
    <rect data-draw pathLength="1" x="0" y="78" width="100" height="122" />
    <rect data-draw pathLength="1" x="108" y="78" width="132" height="122" />
    <rect class="tone" x="158" y="0" width="82" height="70" />
    <g class="pop">
      <path d="M70 12C94 12 112 21 112 32S94 52 70 52C64 52 59 51 55 50L44 62L48 48C36 44 28 38 28 32C28 21 46 12 70 12Z" />
      <path d="M50 28H90M56 37H84" />
    </g>
    <g class="pop" style="--i: 1">
      <polygon points={burst} />
    </g>
    <g class="pop" style="--i: 2">
      <path d="M190 100C204 100 214 106 214 114S204 128 190 128C184 128 180 127 176 125L166 134L169 122C166 120 166 117 166 114C166 106 176 100 190 100Z" />
    </g>
  </svg>
)}
