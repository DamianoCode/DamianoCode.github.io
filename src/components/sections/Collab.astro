---
import { cvReady } from '../../data/cv';
import { getProfile, getSubjects, mailto } from '../../data/profile';
import { localeOf } from '../../i18n';

const locale = localeOf(Astro);
const profile = getProfile(locale);
const subjects = getSubjects(locale);
// CV jest tylko po polsku, więc angielska strona zawsze prosi o nie mailem.
const showCv = cvReady && locale === 'pl';

const copy = {
  pl: {
    title: 'Masz pomysł na aplikację?',
    text: 'Zbuduję ją od bazy danych po interfejs: Next.js, TypeScript i PostgreSQL, z wersją na telefon jako PWA. Tak powstało PlaceMates, które działa na placemates.pl.',
    write: 'Napisz o projekcie',
    see: 'Zobacz PlaceMates',
    team: 'Szukasz developera do zespołu?',
    forms: 'B2B albo etat',
    cv: 'Zobacz CV',
    askCv: 'Poproś o CV',
    job: 'Napisz w sprawie pracy',
  },
  en: {
    title: 'Have an idea for an app?',
    text: 'I will build it from the database to the interface: Next.js, TypeScript and PostgreSQL, with a phone version as a PWA. That is how PlaceMates was made, and it runs at placemates.pl.',
    write: 'Write about a project',
    see: 'See PlaceMates',
    team: 'Looking for a developer for your team?',
    forms: 'B2B or full-time',
    cv: 'See my CV',
    askCv: 'Ask for my CV',
    job: 'Write about a job',
  },
}[locale];
---

<!--
  Przystanek zaraz po projektach: co z tych dowodów wynika dla odwiedzającego. Na pierwszym planie klient
  z pomysłem na aplikację, bo projekty są tym, czego szukam; obok, mniejszy, rekruter szukający kogoś do zespołu.
  Klient, który chce wdrożyć agentów AI, ma swój przystanek w następnej sekcji.
-->
<section class="sheet collab" id="wspolpraca" aria-labelledby="wspolpraca-h">
  <div class="wrap collab-inner">
    <div class="pitch">
      <h2 id="wspolpraca-h" class="pitch-title">{copy.title}</h2>
      <p class="pitch-text">{copy.text}</p>
      <p class="actions pitch-actions">
        <a class="primary" href={mailto(subjects.project)}>{copy.write}</a>
        <a href="#placemates">{copy.see}</a>
      </p>
    </div>

    <div class="team">
      <h3 class="team-title">{copy.team}</h3>
      <p>{copy.forms}, {profile.remote}.</p>
      <p class="actions team-actions">
        {showCv ? <a href="/cv">{copy.cv}</a> : <a href={mailto(subjects.cv)}>{copy.askCv}</a>}
        <a href={mailto(subjects.job)}>{copy.job}</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Arkusz w głębszym odcieniu papieru: odcina się od tła jak pozostałe arkusze, ale nie konkuruje
     z hero i karminowym Kontaktem, które zamykają stronę z obu stron. */
  .collab {
    margin-top: clamp(4rem, 12vh, 8rem);
    /* Następny arkusz (Agenci AI) leży tuż obok, jak kolejna kartka na stosie. */
    margin-bottom: var(--sheet-gap);
    background: var(--paper-deep);
    color: var(--ink);
  }
  .collab-inner {
    display: grid;
    gap: 2.5rem 4rem;
    padding-block: clamp(2.5rem, 7vh, 5rem);
  }
  .pitch {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .pitch-title {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: var(--heavy);
    font-stretch: var(--tight);
    line-height: 0.98;
  }
  .pitch-text {
    font-size: var(--lead);
    line-height: var(--lead-lh);
    max-width: 30em;
  }
  .actions a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .actions a.primary {
    padding: 0.6rem 1.15rem;
    border-radius: var(--radius-control);
    background: var(--accent);
    color: var(--paper);
    text-decoration: none;
  }
  .actions a.primary:hover {
    background: var(--ink);
  }
  .actions a.primary:active {
    transform: translateY(1px);
  }
  .team {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  /* Głębszy papier arkusza zjada kontrast: zwykły --ink-soft dawał tu 4.46:1. Domieszka atramentu podnosi go
     do 5.3:1 w jasnym motywie i do 6.5:1 w ciemnym. */
  .team p:not(.actions) {
    color: color-mix(in srgb, var(--ink-soft) 80%, var(--ink));
  }
  .team-title {
    font-size: var(--step-2);
    font-weight: var(--heavy);
    font-stretch: var(--tight-sub);
    line-height: 1.1;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  @media (min-width: 60rem) {
    .collab-inner {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: end;
    }
    .team {
      padding-top: 0;
      padding-left: 2rem;
      border-top: 0;
      border-left: 1px solid var(--rule);
    }
  }
</style>
