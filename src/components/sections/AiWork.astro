---
import { Image } from 'astro:assets';
import widgetBar from '../../assets/projects/widget-bar.png';
import { aiWork } from '../../data/ai';
import { mailto, subjects } from '../../data/profile';

const { repo, pilot, review } = aiWork.offers;
---

<!-- Arkusz w odwróconych kolorach. Bento to trzy oferty dla zespołu; każda kończy się dowodem z mojej pracy. -->
<section class="sheet ai" id="ai" aria-labelledby="ai-h">
  <div class="wrap block">
    <h2 id="ai-h" class="block-title kinetic" style="--fit: 7.82">Agenci AI</h2>
    <p class="lead">{aiWork.lead}</p>

    <div class="bento">
      <article class="tile tile-repo">
        <h3>{repo.title}</h3>
        <div class="tile-body">
          <p>{repo.text}</p>
          <p class="outcome">{repo.outcome}</p>
          <p class="proof">{repo.proof}</p>
        </div>
      </article>

      <article class="tile tile-pilot">
        <h3>{pilot.title}</h3>
        <p>{pilot.text}</p>
        <p class="outcome">{pilot.outcome}</p>
        <p class="proof">{pilot.proof}</p>
        <a class="tile-link" href="#widget">Zobacz widżet</a>
        <Image
          class="tile-bar"
          src={widgetBar}
          alt="Pasek widżetu: światła sesji, stan i limity konta"
          loading="lazy"
        />
      </article>

      <article class="tile tile-review">
        <h3>{review.title}</h3>
        <p>{review.text}</p>
        <p class="outcome">{review.outcome}</p>
        <p class="proof">{review.proof}</p>
        <a class="tile-link" href="#claudius">Zobacz Claudiusa</a>
      </article>
    </div>

    <p class="ai-cta">
      <a href={mailto(subjects.project)}>Napisz o wdrożeniu</a>
    </p>
  </div>
</section>

<style>
  /* Odwrócone kolory: arkusz odcina się od tła strony w obu motywach. */
  .ai {
    --rule: color-mix(in srgb, var(--paper) 22%, transparent);
    background: var(--ink);
    color: var(--paper);
  }
  .lead {
    margin-top: 1.5rem;
    font-size: var(--lead);
    line-height: var(--lead-lh);
    max-width: 30em;
  }

  .bento {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: 1.25rem;
  }
  h3 {
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    font-weight: 800;
    font-stretch: 115%;
    line-height: 1;
    /* Długie słowa („repozytorium”) dzielą się na wąskim kaflu zamiast wychodzić poza niego. */
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .tile p {
    max-width: 34em;
  }
  .tile-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--display);
    font-weight: 600;
    color: inherit;
    text-decoration-thickness: 2px;
  }

  /* Co zostaje w zespole: zdanie w kroju nagłówkowym, odróżnione od opisu i od dowodu pod nim. */
  .tile p.outcome {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--label-l);
    line-height: 1.35;
    color: inherit;
  }
  .proof {
    font-size: var(--step-small);
  }

  /* Pilot: tło zrzutów widżetu, pasek zadokowany przy dolnej krawędzi kafla jak przy krawędzi ekranu. */
  .tile-pilot {
    background: #0c0c0c;
    color: #efefef;
    padding-bottom: 0;
  }
  .tile-pilot p {
    color: #b4b4b4;
  }
  .tile-pilot .tile-link {
    text-decoration-color: #f0b030;
  }
  .tile-pilot :global(.tile-bar) {
    display: block;
    width: min(100%, 34rem);
    height: auto;
    margin-top: 1.5rem;
    align-self: center;
  }

  .tile-review {
    --select-bg: #f4f6ff;
    --select-ink: #2f45e0;
    background: #2f45e0;
    color: #f4f6ff;
  }
  .tile-review p {
    color: #d3d9ff;
  }

  /* Konfiguracja repozytorium: kafel na tle arkusza, oddzielony samą kreską. */
  .tile-repo {
    border: 1px solid var(--rule);
  }
  .tile-repo p {
    color: color-mix(in srgb, var(--paper) 78%, var(--ink));
  }
  .tile-body {
    display: grid;
    gap: 0.9rem;
  }

  .ai-cta {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--label-l);
  }
  .ai-cta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }
  .ai-cta a:hover {
    background: color-mix(in srgb, var(--paper) 85%, var(--cobalt));
  }
  .ai-cta a:active {
    transform: translateY(1px);
  }
  .ai :focus-visible {
    outline-color: var(--paper);
  }

  @media (min-width: 60rem) {
    .bento {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .tile-repo {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 3rem;
      align-items: start;
    }
  }
</style>
