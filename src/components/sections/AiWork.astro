---
import { Image } from 'astro:assets';
import widgetBar from '../../assets/projects/widget-bar.png';
import { aiWork } from '../../data/ai';

const [sessions, process, models] = aiWork.points;
---

<!-- Arkusz w odwróconych kolorach; w środku bento z trzema kaflami o różnych tłach. -->
<section class="sheet ai" id="ai" aria-labelledby="ai-h">
  <div class="wrap block">
    <h2 id="ai-h" class="block-title kinetic" style="--fit: 7.82">Agenci AI</h2>
    <p class="lead">{aiWork.lead}</p>

    <div class="bento">
      <article class="tile tile-sessions">
        <h3>{sessions.title}</h3>
        <p>{sessions.text}</p>
        <a class="tile-link" href="#widget">Zobacz widżet</a>
        <Image
          class="tile-bar"
          src={widgetBar}
          alt="Pasek widżetu: światła sesji, stan i limity konta"
          loading="lazy"
        />
      </article>

      <article class="tile tile-process">
        <h3>{process.title}</h3>
        <p>{process.text}</p>
        <a class="tile-link" href="#claudius">Zobacz Claudiusa</a>
      </article>

      <article class="tile tile-models plate">
        <h3>{models.title}</h3>
        <p>{models.text}</p>
      </article>
    </div>
  </div>
</section>

<style>
  /* Odwrócone kolory: arkusz odcina się od tła strony w obu motywach. */
  .ai {
    --rule: color-mix(in srgb, var(--paper) 22%, transparent);
    background: var(--ink);
    color: var(--paper);
  }
  .lead {
    margin-top: 1.5rem;
    font-size: clamp(1.35rem, 2.8vw, 2.4rem);
    line-height: 1.3;
    max-width: 30em;
  }

  .bento {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: 1.25rem;
  }
  h3 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    font-stretch: 115%;
    line-height: 1;
  }
  .tile p {
    max-width: 34em;
  }
  .tile-link {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--display);
    font-weight: 600;
    color: inherit;
    text-decoration-thickness: 2px;
  }

  /* Sesje: tło zrzutów widżetu, pasek zadokowany przy dolnej krawędzi kafla jak przy krawędzi ekranu. */
  .tile-sessions {
    background: #0c0c0c;
    color: #efefef;
    padding-bottom: 0;
  }
  .tile-sessions p {
    color: #b4b4b4;
  }
  .tile-sessions .tile-link {
    text-decoration-color: #f0b030;
  }
  .tile-sessions :global(.tile-bar) {
    display: block;
    width: min(100%, 34rem);
    height: auto;
    margin-top: 1.5rem;
    align-self: center;
  }

  .tile-process {
    background: #2f45e0;
    color: #f4f6ff;
  }
  .tile-process p {
    color: #d3d9ff;
  }

  .tile-models {
    color: var(--paper);
  }
  .tile-models p {
    color: color-mix(in srgb, var(--paper) 78%, var(--ink));
  }

  @media (min-width: 60rem) {
    .bento {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .tile-models {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 3rem;
      align-items: start;
    }
  }
</style>
