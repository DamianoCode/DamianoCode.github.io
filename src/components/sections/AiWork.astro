---
import { aiWork, flowSteps } from '../../data/ai';
---

<section class="ai" id="ai" aria-labelledby="ai-h">
  <div class="wrap block">
    <h2 id="ai-h" class="block-title">Agenci AI i Claude Code</h2>
    <p class="lead">{aiWork.lead}</p>

    <div class="points">
      {aiWork.points.map((p) => (
        <div>
          <h3>{p.title}</h3>
          <p class="muted">{p.text}</p>
        </div>
      ))}
    </div>

    <figure class="flow" data-flow>
      <figcaption>Jak zmiana przechodzi przez Claudiusa</figcaption>
      <ol class="track" role="list">
        {flowSteps.map((step) => (
          <li class="station" data-station>
            <span class="rail" aria-hidden="true"></span>
            <b class="name">{step.name}</b>
            <span class="what muted">{step.text}</span>
          </li>
        ))}
      </ol>
    </figure>
  </div>
</section>

<script>
  import { initFlowTrack } from '../../scripts/flow-track';

  const flow = document.querySelector<HTMLElement>('[data-flow]');
  if (flow) initFlowTrack(flow);
</script>

<style>
  /* Odwrócone kolory: pasek wyróżnia sekcję na tle strony w obu motywach. */
  .ai {
    --rule: color-mix(in srgb, var(--paper) 22%, transparent);
    background: var(--ink);
    color: var(--paper);
  }
  .muted {
    color: color-mix(in srgb, var(--paper) 75%, var(--ink));
  }
  .lead {
    font-size: clamp(1.3rem, 2.6vw, var(--step-2));
    line-height: 1.35;
    max-width: 26em;
  }
  .points {
    display: grid;
    gap: 2rem 3rem;
    margin-top: 3rem;
  }
  h3 {
    font-size: var(--step-1);
    font-stretch: 110%;
    margin-bottom: 0.5rem;
  }

  .flow {
    margin: 4rem 0 0;
  }
  figcaption {
    font-family: var(--display);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .station {
    display: grid;
    grid-template-columns: 0.25rem 1fr;
    column-gap: 1rem;
    align-items: start;
    /* Odstęp robi rytm listy; szyna każdego kroku jest osobnym odcinkiem. */
    padding-block: 0.45rem;
  }
  /* Szyna: wypełnia się do kroku, na którym jest czytelnik. */
  .rail {
    position: relative;
    align-self: stretch;
    min-height: 100%;
    background: var(--rule);
  }
  .rail::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--cobalt) 50%, var(--paper));
    transform-origin: top;
    transform: scaleY(var(--fill, 1));
  }
  /* Znacznik na końcu wypełnienia: widać, dokąd doszedł czytelnik. */
  .station.is-active .rail::before {
    content: '';
    position: absolute;
    left: -0.35rem;
    right: -0.35rem;
    top: calc(var(--fill, 1) * 100%);
    height: 2px;
    margin-top: -1px;
    background: var(--paper);
  }
  .name {
    grid-column: 2;
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    font-stretch: 105%;
  }
  .what {
    grid-column: 2;
    font-size: 0.95rem;
  }

  /* Stan bez skryptu: wszystkie kroki czytelne. Skrypt dokłada wyróżnienie bieżącego. */
  .track.is-live .name {
    color: color-mix(in srgb, var(--paper) 60%, var(--ink));
    font-weight: 400;
    font-stretch: 72%;
  }
  .track.is-live .station.is-done .name {
    font-stretch: 92%;
  }
  .track.is-live .station.is-active .name {
    color: var(--paper);
    font-weight: 700;
    font-stretch: 130%;
  }
  .track.is-live .what {
    color: color-mix(in srgb, var(--paper) 58%, var(--ink));
  }
  .track.is-live .station.is-active .what {
    color: color-mix(in srgb, var(--paper) 80%, var(--ink));
  }

  @media (prefers-reduced-motion: no-preference) {
    .name,
    .what,
    .rail::after {
      transition:
        font-stretch 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        font-weight 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        color 0.45s ease,
        transform 0.3s linear;
    }
  }

  @media (min-width: 60rem) {
    .points {
      grid-template-columns: repeat(3, 1fr);
    }
    .track {
      grid-template-columns: repeat(6, 1fr);
    }
    .station {
      grid-template-columns: 1fr;
      row-gap: 0.75rem;
      padding-block: 0;
      padding-right: 1.25rem;
    }
    .rail {
      height: 3px;
      min-height: 0;
    }
    .rail::after {
      transform-origin: left;
      transform: scaleX(var(--fill, 1));
    }
    .station.is-active .rail::before {
      top: -0.35rem;
      bottom: -0.35rem;
      left: calc(var(--fill, 1) * 100%);
      right: auto;
      width: 2px;
      height: auto;
      margin: 0 0 0 -1px;
    }
    .name,
    .what {
      grid-column: 1;
    }
  }
</style>
