---
import { interests } from '../../data/profile';
---

<section class="wrap block" id="po-godzinach" aria-labelledby="po-godzinach-h">
  <h2 id="po-godzinach-h" class="block-title kinetic" style="--fit: 11.19">Po godzinach</h2>
  <p class="block-intro">Kod to nie wszystko. Tym zajmuję się, kiedy laptop jest zamknięty.</p>

  <ul class="interests">
    {interests.map((item) => (
      <li>
        <div class="word-box">
          <h3 class="word" aria-label={item.word}>
            {item.lines.map((line) => <span class="line" aria-hidden="true">{line}</span>)}
          </h3>
        </div>
        <p class="text">{item.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    gap: 0.5rem 3rem;
    padding-block: 1.5rem 1.75rem;
    border-top: 1px solid var(--rule);
  }
  li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* Wszystkie hasła są wąskie i mają ten sam rozmiar; najechany wiersz rozszerza się do pełnej szerokości.
     Linie się nie zawijają, a rozmiar mieści szeroki stan w kolumnie, więc wiersz nie zmienia wysokości. */
  .interests {
    /* Najdłuższa linia („komiksy”) przy szerokości 150% i grubości 700, zmierzona w przeglądarce, w em. */
    --fit: 6.74;
  }
  .word-box {
    container-type: inline-size;
    min-width: 0;
  }
  .word {
    font-size: min(clamp(2.4rem, 7vw, 5.5rem), 100cqi / (var(--fit) * 1.03));
    font-weight: 700;
    font-stretch: 75%;
    line-height: 0.95;
  }
  .line {
    display: block;
    white-space: nowrap;
  }
  .text {
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .word {
      transition: font-stretch 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }
  @media (hover: hover) {
    li:hover .word {
      font-stretch: 150%;
    }
  }

  @media (min-width: 60rem) {
    li {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: end;
    }
    .text {
      padding-bottom: 0.4rem;
    }
  }
</style>
