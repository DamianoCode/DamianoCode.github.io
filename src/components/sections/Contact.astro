---
import { Image } from 'astro:assets';
import avatar from '../../assets/brand/awatar.webp';
import { cvReady } from '../../data/cv';
import { getProfile, getSubjects, mailto } from '../../data/profile';
import { getProjects } from '../../data/projects';
import { projectTone } from '../../data/tones';
import { localeOf } from '../../i18n';

const locale = localeOf(Astro);
const profile = getProfile(locale);
const subjects = getSubjects(locale);
const projects = getProjects(locale);
// CV jest tylko po polsku, więc angielska strona zawsze prosi o nie mailem.
const showCv = cvReady && locale === 'pl';

const copy = {
  pl: {
    title: 'Kontakt',
    fit: 2.63,
    intro: 'Wybierz, w jakiej sprawie piszesz: temat maila uzupełni się sam. Możesz też napisać prosto na adres poniżej.',
    projectQ: 'Masz projekt albo zespół do wdrożenia agentów?',
    projectText: 'Aplikacja od bazy po interfejs albo Claude Code w waszym repozytorium.',
    projectCta: 'Napisz o projekcie',
    jobQ: 'Rekrutujesz?',
    jobText: ['B2B albo etat', 'Napisz, czego szuka zespół.'],
    jobCta: 'Napisz w sprawie pracy',
    copy: 'Kopiuj adres',
    copied: 'Skopiowano',
    failed: 'Nie udało się skopiować. Zaznacz adres powyżej i skopiuj go ręcznie.',
    note: 'Odpisuję sam. Agenci czekają w kolejce.',
    askCv: 'Poproś o CV',
  },
  en: {
    title: 'Contact',
    fit: 2.62,
    intro: 'Pick what you are writing about and the email subject fills itself in. You can also write straight to the address below.',
    projectQ: 'Have a project, or a team that wants to work with agents?',
    projectText: 'An app from the database to the interface, or Claude Code in your repository.',
    projectCta: 'Write about a project',
    jobQ: 'Hiring?',
    jobText: ['B2B or full-time', 'Tell me what the team is looking for.'],
    jobCta: 'Write about a job',
    copy: 'Copy address',
    copied: 'Copied',
    failed: 'Could not copy. Select the address above and copy it by hand.',
    note: 'I reply myself. The agents wait in line.',
    askCv: 'Ask for my CV',
  },
}[locale];

// Stos domyka się nad Kontaktem: krawędzie arkuszy produktów w kolejności z góry strony. Pierwszy leży najgłębiej,
// ostatni tuż pod Kontaktem.
const edges = projects.map((project) => projectTone[project.id]);

// Na wąskich ekranach adres łamie się tylko po „@”, nigdy w środku domeny.
const [emailUser, emailDomain] = profile.email.split('@');
---

<!-- Finał strony: arkusz w kolorze akcentu, adres na całą szerokość. Nad nim wystają krawędzie arkuszy produktów,
     schodkami jak tylny arkusz w znaku: cały stos z góry strony leży pod Kontaktem. -->
<div class="stack-edges" aria-hidden="true" style={`--n: ${edges.length}`}>
  {edges.map((color, i) => <span style={`--i: ${i}; --tone: ${color}`} />)}
</div>
<section class="sheet contact" id="kontakt" aria-labelledby="kontakt-h">
  <div class="wrap block">
  <h2 id="kontakt-h" class="block-title kinetic" style={`--fit: ${copy.fit}`}>{copy.title}</h2>
  <p class="intro">{copy.intro}</p>

  <!-- Najpierw decyzja: dwie ścieżki z gotowym tematem maila. Adres i reszta linków są pod nimi. -->
  <ul class="paths">
    <li>
      <h3 class="path-q">{copy.projectQ}</h3>
      <p>{copy.projectText}</p>
      <a href={mailto(subjects.project)}>{copy.projectCta}</a>
    </li>
    <li>
      <h3 class="path-q">{copy.jobQ}</h3>
      <p>{copy.jobText[0]}, {profile.remote}. {copy.jobText[1]}</p>
      <a href={mailto(subjects.job)}>{copy.jobCta}</a>
    </li>
  </ul>

  <a class="email" href={mailto()}><span>{emailUser}@</span><span>{emailDomain}</span></a>
  <p class="actions more">
    <button
      class="copy"
      type="button"
      data-copy={profile.email}
      data-done={copy.copied}
      data-failed={copy.failed}
      hidden
    >
      <span class="copy-idle">{copy.copy}</span>
      <span class="copy-done" aria-hidden="true">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5 9.5 17.5 19.5 7" pathLength="1" /></svg>
        {copy.copied}
      </span>
    </button>
  </p>
  <p class="copied" role="status" aria-live="polite"></p>

  <!-- Podpis pod listem: w hero agenci czekają przy pustym fotelu, a tutaj człowiek wraca na swoje miejsce.
       Awatar jest tym samym rysunkiem co na profilach; imię stoi obok jako tekst, więc obraz nie potrzebuje opisu. -->
  <div class="sign">
    <p class="signature">
      <Image class="avatar" src={avatar} alt="" width={88} height={88} densities={[1, 2]} loading="lazy" />
      <span>
        <span class="sign-name">{profile.fullName}</span>
        <span class="sign-note">{copy.note}</span>
      </span>
    </p>
    <p class="actions elsewhere">
      <a href={profile.linkedin} rel="me">LinkedIn</a>
      <a href={profile.github} rel="me">GitHub</a>
      {showCv ? <a href="/cv">CV</a> : <a href={mailto(subjects.cv)}>{copy.askCv}</a>}
    </p>
  </div>
  </div>
</section>

<script>
  // Przycisk pojawia się tylko tam, gdzie schowek jest dostępny; bez skryptu zostaje sam link mailto.
  // Udane kopiowanie przechodzi przez adres jak światło kopiarki, a przycisk na chwilę potwierdza je ptaszkiem.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('#kontakt .copied');
  const email = document.querySelector<HTMLElement>('#kontakt .email');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    let timer = 0;
    button.addEventListener('click', async () => {
      let copied = false;
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        copied = true;
        status.textContent = button.dataset.done!;
      } catch {
        status.textContent = button.dataset.failed!;
      }
      button.toggleAttribute('data-done', copied);
      if (copied && email && !reduced.matches) {
        email.animate(
          [
            { transform: 'translateX(-70%)', visibility: 'visible' },
            { transform: 'translateX(70%)', visibility: 'visible' },
          ],
          { duration: 750, easing: 'cubic-bezier(0.45, 0, 0.2, 1)', pseudoElement: '::after' },
        );
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        status.textContent = '';
        button.removeAttribute('data-done');
      }, 2500);
    });
  }
</script>

<style>
  .contact {
    --ink: var(--brand-paper);
    --soft: var(--brand-crimson-soft);
    --select-bg: var(--brand-paper);
    --select-ink: var(--brand-crimson);
    position: relative;
    z-index: 1;
    background: var(--brand-crimson);
    color: var(--ink);
    /* Kontakt leży na wierzchu stosu: cień pada w górę, na krawędzie pod nim. */
    box-shadow: 0 -0.4rem 1rem -0.5rem rgb(0 0 0 / 0.35);
  }

  /* Krawędzie arkuszy: każdy następny jest szerszy i niższy, jak arkusz z przodu znaku. Widać tylko pasek
     u góry każdego; reszta chowa się pod następnym arkuszem, a dół wszystkich pod Kontaktem. */
  .stack-edges {
    --strip: clamp(0.6rem, 1.2vw, 1.05rem);
    --step: clamp(0.5rem, 2vw, 1.6rem);
    --tuck: 2rem;
    position: relative;
    height: calc(var(--n) * var(--strip) + var(--tuck));
    margin: clamp(2rem, 6vh, 4.5rem) max(var(--sheet-gap), (100% - var(--sheet-max)) / 2) calc(-1 * var(--tuck));
  }
  .stack-edges span {
    position: absolute;
    top: calc(var(--i) * var(--strip));
    bottom: 0;
    inset-inline: calc((var(--n) - var(--i)) * var(--step));
    border-radius: 1.5rem 1.5rem 0 0;
    background: var(--tone);
    box-shadow: 0 -0.3rem 0.7rem -0.4rem rgb(0 0 0 / 0.3);
  }
  @media (min-width: 64rem) {
    .stack-edges span {
      border-radius: 2rem 2rem 0 0;
    }
  }

  /* Stos rozkłada się, gdy Kontakt wjeżdża na ekran: krawędzie wysuwają się spod niego, najbliższa pierwsza,
     najgłębsza ostatnia. Bez obsługi osi przewijania i przy ograniczonym ruchu stos jest od razu rozłożony. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stack-edges {
        view-timeline: --stack;
      }
      .stack-edges span {
        --lag: calc((var(--n) - 1 - var(--i)) * 4%);
        animation: fan-out linear both;
        animation-timeline: --stack;
        animation-range: cover var(--lag) cover calc(24% + var(--lag));
      }
    }
  }
  @keyframes fan-out {
    from {
      transform: translateY(calc((var(--n) - var(--i)) * var(--strip)));
    }
  }
  .contact :focus-visible {
    outline-color: var(--ink);
  }
  .intro {
    margin-top: 1rem;
    color: var(--soft);
    font-size: var(--lead);
    line-height: var(--lead-lh);
  }

  /* Adres wypełnia szerokość: na telefonie w dwóch liniach (łamanie po „@”), na szerszych ekranach w jednej.
     Rozmiar wynika ze zmierzonej szerokości napisu w em (Anybody, szerokość 58%, grubość 850). */
  .email {
    --space: calc(min(100vw, 88rem) - 2 * var(--gutter) - 2 * var(--sheet-gap));
    display: block;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    font-family: var(--display);
    font-weight: var(--heavy);
    font-stretch: var(--tight);
    font-size: calc(var(--space) / (4.4 * 1.06));
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    /* Pas światła „kopiarki” (patrz skrypt) przecina adres w poziomie i nie wychodzi poza niego. */
    position: relative;
    width: fit-content;
    overflow-x: clip;
  }
  .email::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      transparent 38%,
      rgb(255 255 255 / 0.28) 47%,
      rgb(255 255 255 / 0.6) 50%,
      rgb(255 255 255 / 0.28) 53%,
      transparent 62%
    );
    /* Pas gaśnie ku górze i dołowi, żeby nie rysował prostokąta na tle arkusza. */
    mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent);
    transform: translateX(-70%);
    visibility: hidden;
  }
  .email span {
    display: block;
    white-space: nowrap;
  }
  .email:hover span {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.1em;
  }
  @media (min-width: 48rem) {
    .email {
      font-size: min(8rem, calc(var(--space) / (7.79 * 1.05)));
    }
    .email span {
      display: inline;
    }
  }

  .more {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
  }

  /* Podpis i linki poza mailem: jeden wiersz pod kreską, na telefonie jeden pod drugim. */
  .sign {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2.5rem;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .signature {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: none;
  }
  .avatar {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--ink);
  }
  .sign-name {
    display: block;
    font-family: var(--display);
    font-weight: var(--heavy);
    font-stretch: var(--tight-sub);
    font-size: var(--step-1);
    line-height: 1.1;
  }
  .sign-note {
    display: block;
    color: var(--soft);
  }
  .elsewhere a {
    color: var(--ink);
    text-decoration-thickness: 2px;
  }
  /* Kopiowanie jest akcją drugiego planu: obrys zamiast wypełnienia, bo pełne przyciski należą do ścieżek wyżej. */
  .copy {
    font: inherit;
    min-height: 2.75rem;
    color: var(--ink);
    background: transparent;
    border: 2px solid var(--ink);
    border-radius: var(--radius-control);
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  .copy:hover {
    color: var(--brand-crimson);
    background: var(--ink);
  }
  /* Obie etykiety leżą w jednej komórce, więc zmiana napisu nie zmienia szerokości przycisku. */
  .copy {
    display: inline-grid;
  }
  .copy[hidden] {
    display: none;
  }
  .copy > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  .copy-done,
  .copy[data-done] .copy-idle {
    visibility: hidden;
  }
  .copy[data-done] .copy-done {
    visibility: visible;
  }
  .copy svg {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    .copy[data-done] svg path {
      stroke-dasharray: 1;
      animation: tick 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes tick {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .copy:active {
    transform: translateY(1px);
  }
  .paths {
    list-style: none;
    display: grid;
    gap: 1.75rem 3rem;
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    padding: 0;
  }
  .paths li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    justify-items: start;
  }
  /* Ścieżki dzieli kreska jak w arkuszu Współpraca: na telefonie pozioma, obok siebie pionowa. */
  .paths li + li {
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .paths p {
    color: var(--soft);
  }
  .path-q {
    hyphens: auto;
    overflow-wrap: break-word;
    font-weight: var(--heavy);
    font-stretch: var(--tight-sub);
    font-size: var(--step-2);
    line-height: 1.1;
  }
  /* Dwie główne akcje sekcji: pełne przyciski w kolorach arkusza. */
  .paths a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    padding: 0.6rem 1.15rem;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: var(--brand-crimson);
    font-family: var(--display);
    font-weight: 600;
    text-decoration: none;
  }
  .paths a:hover {
    background: var(--brand-ink);
    color: var(--brand-paper);
  }
  .paths a:active {
    transform: translateY(1px);
  }
  /* Najwęższe telefony: pytanie o projekt miało cztery wiersze. */
  @media (max-width: 22rem) {
    .path-q {
      font-size: var(--step-1);
    }
  }
  /* Obok siebie ścieżki dzielą wiersze siatki: pytanie, opis i przycisk stoją na tej samej wysokości,
     nawet gdy jedno pytanie zajmuje dwa wiersze, a drugie jeden. */
  @media (min-width: 48rem) {
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      row-gap: 0.75rem;
    }
    .paths li {
      grid-row: span 3;
      grid-template-rows: subgrid;
    }
    .paths li + li {
      padding-top: 0;
      padding-left: 2rem;
      border-top: 0;
      border-left: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    }
  }

  /* Komunikat ma stałe miejsce, więc jego pojawienie się niczego nie przesuwa. */
  .copied {
    min-height: 1.6em;
    margin-top: 0.5rem;
    color: var(--soft);
  }
</style>
