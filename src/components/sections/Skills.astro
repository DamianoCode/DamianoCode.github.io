---
import { alsoUsed, getColumns, getGroupName, getSkills, skillGroups } from '../../data/skills';
import { projectTone } from '../../data/tones';
import { localeOf } from '../../i18n';

const locale = localeOf(Astro);
const columns = getColumns(locale);
const skills = getSkills(locale);
const grouped = skillGroups.map((group) => ({
  group: getGroupName(group, locale),
  items: skills.filter((s) => s.group === group),
}));

const copy = {
  pl: {
    title: 'Umiejętności',
    fit: 4.31,
    intro:
      'Zamiast deklaracji: tabela pokazuje, gdzie naprawdę czego użyłem. Wiersz to umiejętność, kolumna to projekt. Ostatnia kolumna zbiera wcześniejsze repozytoria.',
    yes: 'tak',
    no: 'nie',
    also: 'Poza tabelą',
  },
  en: {
    title: 'Skills',
    fit: 1.8,
    intro:
      'Instead of claims: the table shows where I actually used what. A row is a skill, a column is a project. The last column collects earlier repositories.',
    yes: 'yes',
    no: 'no',
    also: 'Outside the table',
  },
}[locale];

/** Kolor kolumny = kolor karty projektu: tabela łączy się wzrokowo z projektami wyżej. */
const tone: Record<string, string> = { ...projectTone, wczesniej: 'var(--ink-soft)' };

const columnHref = (id: string) => (id === 'wczesniej' ? '#projekty-archiwum' : `#${id}`);
---

<section class="wrap block" id="umiejetnosci" aria-labelledby="umiejetnosci-h">
  <h2 id="umiejetnosci-h" class="block-title kinetic" style={`--fit: ${copy.fit}`}>{copy.title}</h2>
  <p class="block-intro">{copy.intro}</p>

  <!-- Szerokie ekrany: tabela. Wąskie: lista z nazwami projektów. -->
  <table class="matrix" aria-labelledby="umiejetnosci-h">
    <thead>
      <tr>
        <td></td>
        {columns.map((c) => (
          <th scope="col" style={`--c: ${tone[c.id]}`}>
            <a href={columnHref(c.id)}>{c.short}</a>
          </th>
        ))}
      </tr>
    </thead>
    {grouped.map(({ group, items }) => (
    <tbody>
      <tr class="group">
        <th scope="rowgroup" colspan={columns.length + 1}>{group}</th>
      </tr>
      {items.map((s) => (
        <tr>
          <th scope="row">
            <span class="name">{s.name}</span>
            <span class="note">{s.note}</span>
          </th>
          {columns.map((c) => (
            <td style={`--c: ${tone[c.id]}`}>
              {s.usedIn.includes(c.id) ? (
                <span class="hit" role="img" aria-label={copy.yes} />
              ) : (
                <span class="visually-hidden">{copy.no}</span>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
    ))}
  </table>

  {grouped.map(({ group, items }) => (
  <div class="list">
    <h3 class="group-title">{group}</h3>
    <ul>
    {items.map((s) => (
      <li>
        <span class="name">{s.name}</span>
        <span class="note">{s.note}</span>
        <span class="where">
          {columns
            .filter((c) => s.usedIn.includes(c.id))
            .map((c) => (
              <span class="where-item" style={`--c: ${tone[c.id]}`}>{c.short}</span>
            ))}
        </span>
      </li>
    ))}
    </ul>
  </div>
  ))}

  <p class="also">{copy.also}: {alsoUsed.join(', ')}.</p>
</section>

<style>
  .matrix {
    display: none;
    width: 100%;
    border-collapse: collapse;
  }
  /* Nagłówek kolumn zostaje u góry ekranu przez całą tabelę: przy dolnych wierszach wciąż widać, który kolor to który projekt. */
  thead th,
  thead td {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--paper);
  }
  thead th {
    padding: 0.25rem 0.5rem 1rem;
    vertical-align: bottom;
    font-family: var(--display);
    font-weight: 600;
    font-stretch: 85%;
    font-size: var(--label-l);
  }
  /* Nagłówek kolumny prowadzi do karty projektu, więc ma cel dotyku 44 px; kreska zostaje tuż pod napisem. */
  thead a {
    display: inline-flex;
    align-items: flex-end;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 3px solid var(--c);
  }
  /* Linia tylko nad grupą; wiersze w grupie rozdziela sam odstęp. */
  tbody {
    border-top: 1px solid var(--rule);
  }
  .group th {
    padding: 1.25rem 0 0.25rem;
    text-align: left;
    font-family: var(--display);
    font-size: var(--label-s);
    font-weight: 600;
    font-stretch: 100%;
    /* Nagłówek grupy różni się od nazw projektów nad kolumnami wersalikami, nie tylko rozmiarem. */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  tbody tr:not(.group):hover {
    background: color-mix(in srgb, currentColor 7%, transparent);
  }
  /* Kursor nad nagłówkiem kolumny podświetla całą kolumnę: w szerokiej tabeli łatwiej trafić wzrokiem. */
  .matrix:has(thead th:nth-child(2):hover) tbody td:nth-child(2),
  .matrix:has(thead th:nth-child(3):hover) tbody td:nth-child(3),
  .matrix:has(thead th:nth-child(4):hover) tbody td:nth-child(4),
  .matrix:has(thead th:nth-child(5):hover) tbody td:nth-child(5),
  .matrix:has(thead th:nth-child(6):hover) tbody td:nth-child(6),
  .matrix:has(thead th:nth-child(7):hover) tbody td:nth-child(7) {
    background: color-mix(in srgb, currentColor 7%, transparent);
  }
  tbody th {
    width: 36%;
    padding: 0.55rem 1.5rem 0.55rem 0;
    text-align: left;
    font-weight: 400;
  }
  td {
    text-align: center;
  }
  /* Trafienie: kafelek w kolorze projektu. Kolumna czyta się jak pasek z karty projektu. */
  .hit {
    display: inline-block;
    width: 70%;
    max-width: 4.5rem;
    height: 1.6rem;
    border-radius: 0.4rem;
    background: var(--c);
    vertical-align: middle;
  }

  .name {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-stretch: var(--tight-sub);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .note {
    display: block;
    color: var(--ink-soft);
    font-size: var(--step-small);
  }

  .list {
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .group-title {
    font-size: var(--label-s);
    font-weight: 600;
    font-stretch: 100%;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: 0.25rem;
  }
  .list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    padding-block: 0.6rem;
  }
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin-top: 0.35rem;
    font-family: var(--display);
    font-stretch: 85%;
    font-size: var(--label);
  }
  .where-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .where-item::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 0.2rem;
    background: var(--c);
  }

  .also {
    margin-top: 1.5rem;
    color: var(--ink-soft);
  }

  @media (min-width: 52rem) {
    .matrix {
      display: table;
    }
    .list {
      display: none;
    }
  }
</style>
