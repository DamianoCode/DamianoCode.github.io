---
import { getFlowSteps } from '../data/ai';
import { localeOf } from '../i18n';

const locale = localeOf(Astro);
const flowSteps = getFlowSteps(locale);
const caption = { pl: 'Jak zmiana przechodzi przez Claudiusa', en: 'How a change goes through Claudius' }[locale];
---

<figure class="flow" data-flow>
  <figcaption class="visually-hidden">{caption}</figcaption>
  <ol class="track" role="list">
    {flowSteps.map((step) => (
      <li class="station" data-station>
        <span class="rail" aria-hidden="true"></span>
        <b class="name">
          <span class="name-rest">{step.name}</span>
          <span class="name-on" aria-hidden="true">{step.name}</span>
        </b>
        <span class="what">{step.text}</span>
      </li>
    ))}
  </ol>
</figure>

<script>
  import { initFlowTrack } from '../scripts/flow-track';

  const flow = document.querySelector<HTMLElement>('[data-flow]');
  if (flow) initFlowTrack(flow);
</script>

<style>
  /* Kolory dziedziczy po karcie projektu (--ink, --soft, --line). */
  .flow {
    margin: 0;
    width: 100%;
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .station {
    display: grid;
    grid-template-columns: 0.2rem minmax(0, 1fr);
    column-gap: 1.1rem;
    padding-block: 0.15rem;
    cursor: default;
  }
  .rail {
    grid-row: span 2;
    position: relative;
    background: var(--line);
  }
  .rail::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: top;
  }
  .name {
    display: grid;
    justify-items: start;
    font-family: var(--display);
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.05;
    white-space: nowrap;
    padding-top: 0.35rem;
  }
  .name > span {
    grid-area: 1 / 1;
    transform-origin: left center;
  }
  .name-on {
    display: none;
  }
  .what {
    padding-bottom: 0.5rem;
    color: var(--soft);
    font-size: var(--step-small);
  }

  /* Stan bez skryptu: wszystkie kroki czytelne. Skrypt dokłada przebieg. */
  .track.is-live .rail::after {
    transform: scaleY(0);
  }
  .track.is-live .station.is-done .rail::after,
  .track.is-live .station.is-active .rail::after {
    transform: none;
  }

  /*
    Krok, na którym jest zmiana, robi się szeroki i ciężki (oś szerokości to głos tej strony). Żeby telefon
    nie przeliczał tekstu w każdej klatce, oba warianty nazwy są gotowe i nałożone na siebie: przy zmianie
    wąski się rozciąga i gaśnie, a szeroki wychodzi ze ściśnięcia i się pojawia. Animują się tylko
    przezroczystość i transformacja.
    Przygaszenie ma dolny próg: nazwy kroków (duży tekst) trzymają kontrast co najmniej 3:1 na karminie,
    a opisy (zwykły tekst) zostają w pełnym --soft.
  */
  .track.is-live .name-rest {
    font-weight: 400;
    font-stretch: 70%;
    color: color-mix(in srgb, var(--ink) 76%, transparent);
  }
  .track.is-live .name-on {
    display: block;
    font-weight: 800;
    font-stretch: 135%;
    color: var(--ink);
    opacity: 0;
    /* Szeroki wariant jest ok. 2,6 raza szerszy od wąskiego (zmierzone dla wszystkich nazw) i startuje
       ściśnięty do jego szerokości. */
    transform: scaleX(0.385);
    user-select: none;
  }
  .track.is-live .station.is-done .name-rest {
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }
  .track.is-live .station.is-active .name-rest {
    opacity: 0;
    transform: scaleX(2.6);
  }
  .track.is-live .station.is-active .name-on {
    opacity: 1;
    transform: none;
  }
  .track.is-live .station.is-active .what {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .name > span {
      transition:
        opacity 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
        transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
        color 0.4s ease;
    }
    .track.is-live .station.is-active .name > span {
      transition-duration: 0.5s, 0.5s, 0.4s;
      transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1), cubic-bezier(0.16, 1, 0.3, 1), ease;
    }
    /* Nazwy przechodzą co półtorej sekundy, więc mają własne warstwy, ale tylko póki tor jest na ekranie. */
    .track.is-running .name > span {
      will-change: opacity, transform;
    }
    .what {
      transition: color 0.4s ease;
    }
    /* Szyna bieżącego kroku wypełnia się w rytmie kroku. Po ostatnim kroku pełne szyny opróżniają się razem
       ku górze; przy przypięciu kursorem wypełnienie jest od razu. */
    .track.is-live .rail::after {
      transition: transform var(--drain, 0.7s) cubic-bezier(0.65, 0, 0.35, 1);
    }
    .track.is-live .station.is-active .rail::after {
      transition: transform var(--step, 1.5s) linear;
    }
    .track.is-pinned .station.is-active .rail::after {
      transition: none;
    }
  }
</style>
