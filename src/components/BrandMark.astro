---
import { brandMark } from '../data/brand';

/**
 * Znak strony: klawiatura, na której karminowe są tylko klawisze d i c (damianocode). Kolory biorą się ze zmiennych
 * `--mark-body`, `--mark-key`, `--mark-letter`, więc na ciemnym albo karminowym tle znak może się odwrócić.
 * Geometria pochodzi z public/brand/znak-klawiatura.svg.
 */
const { body, keys, viewBox } = brandMark;
---

<svg class="brand-mark" viewBox={viewBox} aria-hidden="true" focusable="false">
  <path class="body" fill-rule="evenodd" d={body} />
  {keys.map(({ name, key, letter }) => (
    <g class={`key key-${name}`}>
      <rect class="cap" {...key} />
      <path class="letter" fill-rule="evenodd" d={letter} />
    </g>
  ))}
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
    width: 3rem;
    height: 2rem;
  }
  .body {
    fill: var(--mark-body, var(--ink));
  }
  .cap {
    fill: var(--mark-key, var(--brand-crimson));
  }
  .letter {
    fill: var(--mark-letter, var(--brand-paper));
  }

  /* Po wczytaniu ktoś raz wystukuje podpis: najpierw d, potem c. */
  @media (prefers-reduced-motion: no-preference) {
    .key {
      animation: press 0.32s cubic-bezier(0.3, 0, 0.2, 1) 0.45s both;
    }
    .key-c {
      animation-delay: 0.68s;
    }
  }
  @keyframes press {
    40% {
      transform: translateY(1.6px);
      filter: brightness(0.82);
    }
  }
</style>
