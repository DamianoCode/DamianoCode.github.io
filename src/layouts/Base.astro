---
import '@fontsource-variable/anybody/standard.css';
import '@fontsource-variable/literata/opsz.css';
import '../styles/global.css';
import anybodyLatin from '@fontsource-variable/anybody/files/anybody-latin-standard-normal.woff2?url';
import anybodyLatinExt from '@fontsource-variable/anybody/files/anybody-latin-ext-standard-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import { getProfile, getSeo } from '../data/profile';
import { languageTag, localeOf, locales, ogLocale, type Localized } from '../i18n';
import { getPublishedPosts } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  /** Ścieżka do obrazka udostępniania w public/. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Dodatkowe dane strukturalne schema.org dla tej strony. */
  jsonLd?: Record<string, unknown>[];
  /** Strona sama wstawia nagłówek w slocie `banner` (strona główna: arkusz hero). */
  ownHeader?: boolean;
  /** Adresy tej samej strony w obu językach (hreflang); tylko strony, które istnieją w obu. */
  alternates?: Localized;
}

const locale = localeOf(Astro);
const profile = getProfile(locale);
const seo = getSeo(locale);

const copy = {
  pl: {
    skip: 'Przejdź do treści',
    imageAlt: 'agent z głową terminala siedzi nocą na murku nad miastem. Podpis: Człowiek w pętli.',
  },
  en: {
    skip: 'Skip to content',
    imageAlt: 'a terminal-headed agent sits on a parapet above the city at night. Caption: Human in the loop.',
  },
}[locale];

const {
  title = seo.title,
  description = seo.description,
  image = locale === 'pl' ? '/og.jpg' : '/og-en.jpg',
  type = 'website',
  noindex = false,
  jsonLd = [],
  ownHeader = false,
  alternates,
} = Astro.props;

const site = Astro.site!;
const hasTitle = Astro.slots.has('masthead');
// Pusty kanał RSS nie jest reklamowany ani w nagłówku, ani w stopce; wpisy są tylko po polsku.
const hasPosts = locale === 'pl' && (await getPublishedPosts()).length > 0;
// Przy build.format 'file' ścieżki kończą się na .html; adres kanoniczny ich nie zawiera.
const cleanPath =
  Astro.url.pathname
    .replace(/(index)?\.html$/, '')
    .replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cleanPath, site).href;
const imageUrl = new URL(image, site).href;
// Opis gotowego obrazka udostępniania (nocna scena z podpisem), nie samej osoby.
const imageAlt = image.startsWith('/og') ? `${profile.fullName}, damianocode: ${copy.imageAlt}` : profile.fullName;
const alternateUrls = alternates
  ? locales.map((l) => ({ lang: languageTag[l], href: new URL(alternates[l], site).href }))
  : [];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', site).href,
  name: profile.fullName,
  givenName: profile.name,
  familyName: profile.surname,
  jobTitle: profile.role,
  url: site.href,
  email: `mailto:${profile.email}`,
  image: imageUrl,
  address: { '@type': 'PostalAddress', addressLocality: profile.city, addressCountry: 'PL' },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: seo.knowsAbout,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', site).href,
  name: profile.fullName,
  url: site.href,
  inLanguage: locales.map((l) => languageTag[l]),
  author: { '@id': person['@id'] },
};

---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    <link rel="canonical" href={canonical} />
    {alternateUrls.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates.pl, site).href} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates && locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:site_name" content={profile.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#17171a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {hasPosts && (
      <link rel="alternate" type="application/rss+xml" title={`Blog, ${profile.fullName}`} href="/rss.xml" />
    )}

    <link rel="preload" href={anybodyLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={anybodyLatinExt} as="font" type="font/woff2" crossorigin />

    {[person, website, ...jsonLd].map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#tresc">{copy.skip}</a>
    {/* Karminowy arkusz podstrony to jeden kształt z dwóch elementów: górna część z menu jest nagłówkiem strony
        (banner), dolna z tytułem otwiera <main>, żeby tytuł był pierwszą rzeczą w treści. */}
    {ownHeader ? (
      <slot name="banner" />
    ) : (
      <header class:list={['sheet masthead', { 'masthead-top': hasTitle }]}>
        <SiteHeader />
      </header>
    )}
    <main id="tresc">
      {!ownHeader && hasTitle && (
        <div class="sheet masthead masthead-title">
          <div class="wrap masthead-inner">
            <slot name="masthead" />
          </div>
        </div>
      )}
      <slot />
    </main>
    <footer class="wrap site-foot">
      <p>{profile.fullName}, {profile.role.toLowerCase()}, {profile.city}</p>
      {/* Na stronie głównej te linki są już w Kontakcie tuż nad stopką; strona kończy się na Kontakcie. */}
      {(!ownHeader || hasPosts) && (
        <p class="foot-links">
          {!ownHeader && <a href={profile.github} rel="me">GitHub</a>}
          {!ownHeader && <a href={profile.linkedin} rel="me">LinkedIn</a>}
          {hasPosts && <a href="/rss.xml">RSS</a>}
        </p>
      )}
    </footer>
  </body>
</html>

<script>
  import { initAnchorScroll } from '../scripts/anchor-scroll';

  initAnchorScroll();

  // Dla tych, którzy zaglądają w narzędzia deweloperskie: kod strony jest publiczny.
  const [peek, open] =
    document.documentElement.lang === 'en'
      ? ['Looking under the hood?', 'The code of this site is public:']
      : ['Zaglądasz pod spód?', 'Kod tej strony jest publiczny:'];
  console.log(
    `%c${peek}%c ${open} https://github.com/DamianoCode/DamianoCode.github.io`,
    'background:#be2337;color:#e9e5de;font:700 13px/1.6 sans-serif;padding:2px 8px;border-radius:4px',
    'font:13px/1.6 sans-serif',
  );
</script>

<style>
  /* Podstrony zaczynają się karminowym arkuszem, jak Kontakt na stronie głównej: nagłówek i tytuł strony w środku.
     Znak na karminie: papierowy korpus, klawisze d i c w sadzy. */
  .masthead {
    --ink: var(--brand-paper);
    --ink-soft: var(--brand-crimson-soft);
    --accent: var(--brand-paper);
    --select-bg: var(--brand-paper);
    --select-ink: var(--brand-crimson);
    --mark-body: var(--brand-paper);
    --mark-key: var(--brand-ink);
    --mark-letter: var(--brand-paper);
    margin-top: var(--sheet-gap);
    background: var(--brand-crimson);
    color: var(--ink);
  }
  .masthead-top {
    border-end-start-radius: 0;
    border-end-end-radius: 0;
  }
  .masthead-title {
    margin-top: 0;
    border-start-start-radius: 0;
    border-start-end-radius: 0;
  }
  .masthead :focus-visible {
    outline-color: var(--ink);
  }
  .masthead-inner {
    padding-block: clamp(1.5rem, 6vh, 4rem) clamp(2rem, 6vh, 3.5rem);
  }

  .site-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 3rem 2.5rem;
    color: var(--ink-soft);
    font-family: var(--display);
    font-size: var(--label-s);
    font-stretch: 90%;
  }
  .foot-links {
    display: flex;
    gap: 1.25rem;
    font-family: var(--display);
    font-weight: 600;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
