---
import Base from '../layouts/Base.astro';
---

<Base title="Nie ma takiej strony" description="Ta strona nie istnieje albo została przeniesiona." noindex>
  <h1 slot="masthead">404</h1>
  <section class="wrap page">
    <p>Pod tym adresem nic nie ma. Sprawdź adres albo wróć na stronę główną.</p>
    <a href="/">Strona główna</a>
  </section>
</Base>

<style>
  .page {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  h1 {
    font-size: clamp(6rem, 30vw, 20rem);
    font-stretch: 50%;
    font-weight: 800;
    line-height: 0.8;
  }
  a {
    font-family: var(--display);
    font-weight: 600;
  }
</style>
