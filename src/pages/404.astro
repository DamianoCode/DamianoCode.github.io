---
import Base from '../layouts/Base.astro';
---

<Base title="Nie ma takiej strony" description="Ta strona nie istnieje albo została przeniesiona." noindex>
  <section class="wrap page">
    <h1>404</h1>
    <p>Pod tym adresem nic nie ma. Sprawdź adres albo wróć na stronę główną.</p>
    <a href="/">Strona główna</a>
  </section>
</Base>

<style>
  .page {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(3rem, 12vh, 8rem);
    min-height: 60vh;
  }
  h1 {
    font-size: clamp(6rem, 30vw, 20rem);
    font-stretch: 50%;
    font-weight: 800;
    line-height: 0.8;
  }
  a {
    font-family: var(--display);
    font-weight: 600;
  }
</style>
