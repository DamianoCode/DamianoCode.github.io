---
import Base from '../layouts/Base.astro';
import { cv, cvReady } from '../data/cv';
import { mailto, profile, subjects } from '../data/profile';
import { projects } from '../data/projects';

const sections = [
  { title: 'Doświadczenie', entries: cv.experience },
  { title: 'Edukacja', entries: cv.education },
].filter((s) => s.entries.length > 0);
---

<Base
  title={`CV, ${profile.fullName}, ${profile.role.toLowerCase()}`}
  description={`Doświadczenie zawodowe i edukacja: ${profile.fullName}, ${profile.role.toLowerCase()} z Zamościa.`}
  noindex={!cvReady}
>
  <h1 slot="masthead" class="page-title">CV</h1>
  <section class="wrap page">

    {!cvReady ? (
      <>
        <div class="empty-state">
          <p>
            Pełne CV jest w przygotowaniu. Szczegóły doświadczenia podam w mailu, a poniżej jest skrót tego,
            co zbudowałem.
          </p>
          <p class="actions">
            <a href={mailto(subjects.cv)}>Poproś o CV</a>
            <a href="/#projekty">Zobacz projekty</a>
          </p>
        </div>
        {/* Oś czasu z projektów: zanim powstanie CV, strona i tak odpowiada na pytanie „co robił”. */}
        <section class="cv-section">
          <h2>Projekty w skrócie</h2>
          <ol>
            {projects.map((p) => (
              <li>
                <span class="period">{p.year}</span>
                <div>
                  <h3><a href={`/#${p.id}`}>{p.name}</a></h3>
                  <p class="place">{p.kind}{p.status && `, ${p.status}`}</p>
                  <p>{p.summary}</p>
                  <p class="stack">{p.stack.join(', ')}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      </>
    ) : (
      <>
        {cv.pdf && (
          <p class="actions download">
            <a href={cv.pdf} download>Pobierz CV (PDF)</a>
          </p>
        )}
        {sections.map((section) => (
          <section class="cv-section">
            <h2>{section.title}</h2>
            <ol>
              {section.entries.map((entry) => (
                <li>
                  <span class="period">{entry.period}</span>
                  <div>
                    <h3>{entry.title}</h3>
                    <p class="place">{entry.place}</p>
                    {entry.description && <p>{entry.description}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </>
    )}
  </section>
</Base>

<style>
  .empty-state + .cv-section {
    margin-top: 4rem;
  }
  .cv-section h3 a {
    color: inherit;
    text-decoration-color: var(--cobalt);
  }
  .stack {
    margin-top: 0.5rem;
    font-family: var(--display);
    font-stretch: 90%;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .download {
    margin-bottom: 3rem;
  }
  .cv-section + .cv-section {
    margin-top: 4rem;
  }
  .cv-section h2 {
    font-size: var(--step-3);
    font-stretch: 120%;
    margin-bottom: 1rem;
  }
  .cv-section ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cv-section li {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .period {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .cv-section h3 {
    font-size: var(--step-1);
  }
  .place {
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  @media (min-width: 48rem) {
    .cv-section li {
      grid-template-columns: 12rem 1fr;
    }
  }
</style>
